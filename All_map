      SelectedPlayer = Option[1]
   end,
})

-- ระบบอัปเดตรายชื่อผู้เล่นอัตโนมัติ
local function UpdatePlayerList()
   local pList = {}
   for _, p in pairs(Players:GetPlayers()) do
      if p ~= LocalPlayer then
         table.insert(pList, p.Name)
      end
   end
   PlayerDropdown:Refresh(pList)
end

UpdatePlayerList()
Players.PlayerAdded:Connect(UpdatePlayerList)
Players.PlayerRemoving:Connect(UpdatePlayerList)

Tab1:CreateButton({
   Name = "วาปไปหาผู้เล่นที่เลือก",
   Callback = function()
      if SelectedPlayer and Players:FindFirstChild(SelectedPlayer) then
         local targetChar = Players[SelectedPlayer].Character
         if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
         end
      end
   end,
})


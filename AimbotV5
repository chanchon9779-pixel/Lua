-- ฟังก์ชันเช็คกำแพง (Wallcheck)
local function IsVisible(targetPart)
   if not Settings.WallCheck then return true end
   local origin = Camera.CFrame.Position
   local raycastParams = RaycastParams.new()
   raycastParams.FilterType = RaycastFilterType.Exclude
   raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
   
   local result = workspace:Raycast(origin, targetPart.Position - origin, raycastParams)
   return result == nil
end

-- ฟังก์ชันหาเป้าหมาย Aimbot
local function GetClosestTarget()
   local closestPlayer = nil
   local shortestDistance = Settings.FOVSize
   local mousePos = UserInputService:GetMouseLocation()

   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
         
         -- เช็คทีม
         if Settings.TeamCheck and player.Team == LocalPlayer.Team then
            continue
         end

         local hrp = player.Character.HumanoidRootPart
         local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

         if onScreen then
            local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if distance < shortestDistance then
               -- เช็คกำแพง
               if IsVisible(hrp) then
                  shortestDistance = distance
                  closestPlayer = player
               end
            end
         end
      end
   end
   return closestPlayer
end

-- ลูปการทำงาน Aimbot & Hitbox & ESP
RunService.RenderStepped:Connect(function()
   -- Aimbot Loop
   if Settings.AimbotEnabled then
      local target = GetClosestTarget()
      if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
      end
   end

   -- Hitbox & ESP Loop
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = player.Character.HumanoidRootPart
         
         -- ขยาย Hitbox
         if Settings.HitboxEnabled then
            hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
            hrp.Transparency = 0.7
            hrp.BrickColor = BrickColor.new("Really red")
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
         else
            hrp.Size = Vector3.new(2, 2, 1)
            hrp.Transparency = 1
         end

         -- ESP มองทะลุ
         local highlight = player.Character:FindFirstChild("SunESP")
         if Settings.ESPEnabled then
            if not highlight then
               highlight = Instance.new("Highlight")
               highlight.Name = "SunESP"
               highlight.FillColor = Color3.fromRGB(255, 0, 0)
               highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
               highlight.Parent = player.Character
            end
         else
            if highlight then
               highlight:Destroy()
            end
         end
      end
   end
end)

-- ระบบบิน (Fly)
local bv, bg
RunService.RenderStepped:Connect(function()
   if Settings.FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local hrp = LocalPlayer.Character.HumanoidRootPart
      if not hrp:FindFirstChild("FlyBV") then
         bv = Instance.new("BodyVelocity")
         bv.Name = "FlyBV"
         bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
         bv.Parent = hrp
         
         bg = Instance.new("BodyGyro")
         bg.Name = "FlyBG"
         bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
         bg.P = 9e4
         bg.Parent = hrp
      end

      bg.CFrame = Camera.CFrame
      local moveDir = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").MoveDirection
      bv.Velocity = (Camera.CFrame.LookVector * moveDir.Z * -Settings.FlySpeed) + (Camera.CFrame.RightVector * moveDir.X * Settings.FlySpeed)
   else
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = LocalPlayer.Character.HumanoidRootPart
         if hrp:FindFirstChild("FlyBV") then hrp.FlyBV:Destroy() end
         if hrp:FindFirstChild("FlyBG") then hrp.FlyBG:Destroy() end
      end
   end
end)



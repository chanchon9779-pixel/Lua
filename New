-- ================= ESP SECTION =================
MainTab:CreateSection("ESP Player")

local function ApplyESP(player)
    if player == LocalPlayer then return end
    
    local function AddHighlight(character)
        if not character then return end
        
        if character:FindFirstChild("SunzaESP") then
            character.SunzaESP:Destroy()
        end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "SunzaESP"
        highlight.Adornee = character
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Enabled = ESP_Enabled
        highlight.Parent = character
        
        ESP_Highlights[player] = highlight
    end

    if player.Character then
        AddHighlight(player.Character)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if ESP_Enabled then
            AddHighlight(char)
        end
    end)
end

for _, player in pairs(Players:GetPlayers()) do
    ApplyESP(player)
end

Players.PlayerAdded:Connect(ApplyESP)

MainTab:CreateToggle({
   Name = "ESP Player (มองเห็นผู้เล่น)",
   CurrentValue = false,
   Flag = "ESPToggle",
   Callback = function(Value)
      ESP_Enabled = Value
      for player, highlight in pairs(ESP_Highlights) do
         if highlight and highlight.Parent then
            highlight.Enabled = Value
         end
      end
   end,
})


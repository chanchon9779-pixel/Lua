-- ** ระบบปุ่ม Toggle สำหรับเปิด/ปิด UI หน้าจอ **
local ScreenGui = Instance.new("ScreenGui")
local ToggleButton = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

ScreenGui.Parent = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.Name = "SunScriptToggleGui"

ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
ToggleButton.Position = UDim2.new(0.015, 0, 0.15, 0)
ToggleButton.Size = UDim2.new(0, 50, 0, 50)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = "SUN"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 18.000
ToggleButton.Active = true
ToggleButton.Draggable = true -- สามารถลากปุ่มไปมาบนหน้าจอได้

UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = ToggleButton

local uiOpen = true
ToggleButton.MouseButton1Click:Connect(function()
    uiOpen = not uiOpen
    Rayfield:SetVisibility(uiOpen)
end)

